<IfModule mod_rewrite.c>
  RewriteEngine On
  Options -Indexes
  DirectoryIndex index.html index.php

  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

  # Force HTTPS and canonicalize non-WWW (except on localhost / development hosts)
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteCond %{HTTP_HOST} !^192\.168\. [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://salvinindia.com/$1 [R=301,L]

  # Redirect legacy /index.html to root /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://salvinindia.com/ [R=301,L]

  # Redirect legacy *.html requests to clean URLs
  RewriteCond %{THE_REQUEST} \s/([^.\s]+)\.html[\s?] [NC]
  RewriteRule ^([^.]+)\.html$ https://salvinindia.com/$1 [R=301,L]

  # Route API requests to PHP backend
  RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

  # Serve existing file directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve existing directory directly (mod_dir and DirectoryIndex will handle index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Serve pre-rendered static HTML directly if a matching index.html exists in a subfolder
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]

  # Single Page Application fallback
  RewriteRule ^ /index.html [L]
</IfModule>
